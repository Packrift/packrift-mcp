{
  "name": "packrift-mcp-server",
  "version": "0.2.10",
  "description": "MCP server for Packrift exact-spec packaging procurement, live pricing, inventory, reorder, quote, and cart handoff.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://mcp.packrift.com/start",
  "repository": {
    "type": "git",
    "url": "https://github.com/Packrift/packrift-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Packrift/packrift-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remote-mcp",
    "ecommerce",
    "packaging",
    "procurement",
    "shopify",
    "cart-handoff",
    "inventory",
    "ai-commerce"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "node dist/node.js",
    "eval:live": "node scripts/run-live-evals.mjs",
    "smoke:cart-handoff": "node scripts/smoke-cart-handoff.mjs",
    "check:distribution": "node scripts/check-mcp-distribution.mjs",
    "check:agent-capture": "node scripts/check-agent-capture.mjs",
    "build:agent-capture-outreach": "node scripts/build-agent-capture-outreach.mjs",
    "build:claude-connector-submission": "npm run build --silent && node scripts/build-claude-connector-submission.mjs",
    "build:directory-submission-pack": "node scripts/build-mcp-directory-submission-pack.mjs",
    "build:directory-submit-actions": "node scripts/build-mcp-directory-submit-actions.mjs",
    "snapshot:funnel": "node scripts/build-mcp-funnel-snapshot.mjs",
    "build:attribution-funnel-note": "node scripts/build-mcp-attribution-funnel-note.mjs",
    "check:static-availability": "node scripts/check-static-availability.mjs",
    "check:cart-continuity": "npm run build && node scripts/check-create-cart-continuity.mjs",
    "build:llms-full": "node scripts/build-llms-full-from-ga4.mjs",
    "refresh:llms-full": "node scripts/refresh-llms-full-priority.mjs",
    "purge:cache": "node scripts/purge-cloudflare-cache.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@types/node": "^25.7.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
